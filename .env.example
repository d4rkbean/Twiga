# Copy to .env then adjust. All the configuration goes through this file.

# PostgreSQL password (user "finance", database "finance").
# Change it before any production use, BEFORE the first start: on an
# already-initialized pgdata volume, changing this value does not change the
# password already stored in Postgres.
DB_PASSWORD=changeme

# Enables authentication (recommended as soon as the app leaves your own
# machine).
AUTH_ENABLED=true

# Password of the admin account, used ONLY ONCE: on the very first start on an
# empty database, a migration creates the "admin" account with this password.
# Once that account exists this variable has no effect anymore: changing
# AUTH_PASSWORD here will not change the password of an instance that has
# already started. To change the password afterwards, use Settings > Security >
# Change the password, or Settings > Security > Users as an admin to reset
# another account's password.
# This is a well-known default value: change it on first login.
AUTH_PASSWORD=changeme

# There is no SECRET_KEY: the secret that signs session cookies is generated
# on the first start and kept in the database (app_state table). Nothing to
# configure, and it is deliberately left out of the exports.

# Port exposed on the host (the container listens on 8080 internally).
PORT=8181

# --- Optional security settings (empty = previous behavior, see README) ---

# Host address the port listens on. 127.0.0.1: reachable from this machine
# only (reverse proxy on the same host). Empty: every address.
BIND_ADDRESS=

# Extra origins whose forms are accepted, comma-separated, e.g.
# https://twiga.example.com. Only needed behind a reverse proxy that changes
# the Host header without setting X-Forwarded-Host.
TRUSTED_ORIGINS=

# Host names Twiga answers to, comma-separated, e.g. twiga.local,192.168.1.20.
# Protects against DNS rebinding. Empty: every host name.
ALLOWED_HOSTS=

# Secure attribute of the cookies: auto (default) when the request arrives over
# HTTPS, directly or through a proxy sending X-Forwarded-Proto: https; true
# always (HTTPS only); false never.
COOKIE_SECURE=auto

# Addresses of the reverse proxies whose X-Forwarded-For header is believed
# (comma-separated), so that the limit on failed sign-ins counts the real
# client address. Empty: the address of the direct connection.
TRUSTED_PROXIES=

# Largest JSON backup accepted by Settings > Data > Restore, in MB.
RESTORE_MAX_MB=50

# Exposes the living style guide at /design-system (a development tool).
# Leave it at false in production.
SHOW_DESIGN_SYSTEM=false

# Makes the "L'autre voie" interface variant selectable in Mon profil > Affichage.
# Each user then picks "Classique" or "L'autre voie"; both interfaces cover
# every screen. Leave it at false to keep only the Classic interface: accounts
# set to the other way then get the Classic one.
ENABLE_OTHER_WAY=false
